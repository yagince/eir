{
  // SvelteKit's generated base config already sets module resolution, `allowJs`/`checkJs`,
  // `allowImportingTsExtensions` (needed for `#lib/*.ts` imports) and friends.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true
  },
  // TypeScript does not merge includes/excludes with the base config, so these
  // mirror what SvelteKit recommends.
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
