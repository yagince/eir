{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Scope is the app frontend. docs/ is the published landing page, a separate
  // hand-written artifact that happens to contain JS.
  "ignorePatterns": ["docs/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // Every sort call in this codebase runs on a fresh array built by spreading
    // a Set or Map (`[...seen].sort()`), so there is no shared array to mutate.
    // toSorted() would allocate a second copy to protect a throwaway one.
    "unicorn/no-array-sort": "off",

    // Complexity limits. ESLint's default max of 20 is the loosest setting that
    // still had something to say here, and nothing is exempted: the one function
    // over it (settings import, at 33) was split and its validation extracted to
    // $lib/settings-import.ts, which made it unit-testable in the process.
    // max-statements is deliberately absent — at its default of 10 it reports 16
    // functions, none of which are actually hard to read.
    "complexity": ["error", { "max": 20 }],
    "max-depth": "error",
    "max-params": "error",
    "max-nested-callbacks": "error",
    "unicorn/max-nested-calls": "error"
  },
  "overrides": [
    {
      // oxlint parses only the <script> block of a .svelte file, so anything the
      // markup touches looks untouched from here. `bind:this` targets are the
      // common case: declared in the script, assigned by the template.
      "files": ["**/*.svelte"],
      "rules": {
        "no-unassigned-vars": "off"
      }
    }
  ]
}
